{
  "name": "glyphforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "community:validator": "node scripts/build-community-validator.mjs",
    "community:db-test": "node scripts/test-community-db.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "typecheck": "tsc --noEmit",
    "examples:p1b": "node scripts/export-p1b-examples.mjs",
    "bench": "vitest run src/tests/performance.test.ts --reporter=verbose",
    "lint": "node scripts/lint-release.mjs",
    "secrets:scan": "node scripts/secret-scan.mjs",
    "secrets:staged": "node scripts/secret-scan.mjs --staged-only"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@uiw/react-codemirror": "^4.25.0",
    "@xyflow/react": "^12.9.0",
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^4.2.0",
    "lucide-react": "^0.468.0",
    "opencc-js": "^1.4.2",
    "pinyin-pro": "^3.29.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^3.2.4"
  }
}
